# VibeMCP Environment Configuration
# Copy this file to .env and fill in your values
#
# IMPORTANT: Never commit the .env file to version control.
# Your credentials are private to you.

# =============================================================================
# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Desktop Application)
# Add http://localhost:4100/code as an authorized redirect URI
# Enable Gmail API and Google Calendar API
# =============================================================================

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# Microsoft Azure App Registration
# Get these from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Register a new application
# Enable "Allow public client flows" under Authentication
# No client secret needed (Device Code Flow uses public client)
# =============================================================================

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_TENANT_ID=common

# =============================================================================
# VibeMCP Configuration
# =============================================================================

# Output format: toon (recommended, ~51% token savings) or json
VIBEMCP_OUTPUT_FORMAT=toon

# Override config directory (default: ~/.vibemcp/)
# VIBEMCP_CONFIG_DIR=/custom/path
